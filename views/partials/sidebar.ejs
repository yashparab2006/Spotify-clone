        <!-- ========== SIDEBAR ========== -->
        <div class="sidebar">
            <div class="nav">
                <div class="nav-option <%= (typeof activePage !== 'undefined' && activePage === 'home') ? 'active-nav' : '' %>" id="navHome">
                    <i class="fa-solid fa-house"></i>
                    <a href="/">Home</a>
                </div>
                <div class="nav-option <%= (typeof activePage !== 'undefined' && activePage === 'search') ? 'active-nav' : '' %>" id="navSearch">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <a href="/search">Search</a>
                </div>
            </div>
            <div class="library">
                <div class="options">
                    <div class="lib-option nav-option <%= (typeof activePage !== 'undefined' && activePage === 'library') ? 'active-nav' : '' %>" id="navLibrary">
                        <img src="/assesst/library_icon.png" alt="Library">
                        <a href="/library">Your Library</a>
                    </div>
                    <div class="icons">
                        <i class="fa-solid fa-plus" id="addPlaylistIcon" title="Create playlist"></i>
                        <i class="fa-solid fa-arrow-right" id="expandLibIcon"></i>
                    </div>
                </div>
                <div class="lib-boxes">
                    <div class="box" id="createPlaylistBox">
                        <p class="box-p1">Create your first playlist</p>
                        <p class="box-p2">It's easy, we'll help you</p>
                        <button class="badge" id="createPlaylistBtn">Create playlist</button>
                    </div>
                    <div class="box" id="browsePodcastBox">
                        <p class="box-p1">Let's find some podcasts to follow</p>
                        <p class="box-p2">We'll keep you updated on new episodes</p>
                        <a href="/podcasts" class="badge" id="browsePodcastsBtn" style="text-decoration:none;display:inline-block;line-height:2rem;text-align:center;">Browse podcasts</a>
                    </div>
                </div>
                <!-- User-created playlists appear here -->
                <div class="sidebar-playlists" id="sidebarPlaylists">
                    <% if (typeof playlists !== 'undefined' && playlists.length > 0) { %>
                        <% playlists.forEach(function(pl) { %>
                            <div class="sidebar-playlist-item" data-id="<%= pl.id %>">
                                <i class="fa-solid fa-music"></i>
                                <span><%= pl.name %></span>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <!-- Spotify Sidebar Bottom Legal & Privacy Footer -->
                <div class="sidebar-legal-footer">
                    <div class="sidebar-legal-links">
                        <a href="/legal" class="sidebar-legal-link">Legal</a>
                        <a href="/safety-privacy-center" class="sidebar-legal-link">Safety & Privacy Center</a>
                        <a href="/privacy-policy" class="sidebar-legal-link">Privacy Policy</a>
                        <a href="/cookies" class="sidebar-legal-link">Cookies</a>
                        <a href="/about-ads" class="sidebar-legal-link">About Ads</a>
                        <a href="/accessibility" class="sidebar-legal-link">Accessibility</a>
                        <a href="/cookies" class="sidebar-legal-link">Cookies</a>
                    </div>
                    <button class="sidebar-lang-btn" id="sidebarLangBtn" type="button" title="Choose language">
                        <i class="fa-solid fa-globe"></i> <span id="sidebarLangLabel">English</span>
                    </button>
                </div>
            </div>
        </div>

