        <!-- ========== RIGHT SIDEBAR (SLIDING RAIL & EXPANDED PANEL) ========== -->
        <div class="right-sidebar collapsed" id="rightSidebar">
            <!-- Draggable Left Sash to Slide / Resize Window -->
            <div class="right-sidebar-slide-sash" id="rightSidebarSlideSash" title="Drag to slide window"></div>

            <!-- 1. Collapsed Rail View (Matches User Screenshot 2) -->
            <div class="right-sidebar-rail" id="rightSidebarRail" title="Now playing view">
                <button class="rail-expand-btn" id="railExpandBtn" title="Now playing view" aria-label="Expand right sidebar">
                    <i class="fa-solid fa-chevron-left"></i>
                    <span class="custom-tooltip">Now playing view</span>
                </button>
            </div>

            <!-- 2. Expanded Panel View (Matches User Screenshot 1) -->
            <div class="right-sidebar-expanded-content" id="rightSidebarExpanded">
                <div class="right-sidebar-header">
                    <button class="right-sidebar-icon-btn" id="closeRightSidebarBtn" title="Collapse sidebar" aria-label="Collapse right sidebar">
                        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M1 3a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V3zm1.5 0v10a.5.5 0 0 0 .5.5H13a.5.5 0 0 0 .5-.5V3a.5.5 0 0 0-.5-.5H3a.5.5 0 0 0-.5.5zm8 2.5a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zM5.354 5.646a.5.5 0 1 0-.708.708L6.293 8l-1.647 1.646a.5.5 0 0 0 .708.708l2-2a.5.5 0 0 0 0-.708l-2-2z"/>
                        </svg>
                    </button>
                    <span class="right-sidebar-header-title" id="rightSidebarHeaderTitle">Now playing</span>
                    <div style="width:36px;"></div>
                </div>

                <!-- Empty State: Matches User Screenshot -->
                <div class="right-sidebar-empty" id="rightSidebarEmpty">
                    <h2 class="right-sidebar-title">Find something to play</h2>
                    <a href="/search" class="badge search-pill-btn" id="rightSidebarSearchBtn" style="text-decoration:none; display:inline-block; text-align:center;">Search</a>
                </div>

                <!-- Active Now Playing Content -->
                <div class="right-sidebar-content" id="rightSidebarContent" style="display:none;">
                    <div class="now-playing-cover-wrapper">
                        <img src="/assesst/card1img.jpeg" id="rightSidebarCover" alt="Cover" class="now-playing-large-cover" onerror="this.onerror=null;this.src='/assesst/card1img.jpeg';">
                    </div>
                    <div class="now-playing-meta">
                        <div class="now-playing-titles">
                            <h3 class="now-playing-track-title" id="rightSidebarTrackTitle">Top 50 - Global</h3>
                            <p class="now-playing-track-artist" id="rightSidebarTrackArtist">Spotify Charts</p>
                        </div>
                        <i class="fa-regular fa-heart now-playing-like-btn" id="rightSidebarLikeBtn" title="Save to Your Library"></i>
                    </div>

                    <!-- About the Artist Card -->
                    <div class="about-artist-card" id="rightSidebarArtistCard">
                        <div class="about-artist-header">
                            <img src="/assesst/card1img.jpeg" id="rightSidebarArtistImg" class="about-artist-avatar" alt="Artist" onerror="this.onerror=null;this.src='/assesst/card1img.jpeg';">
                            <div class="about-artist-info">
                                <h4>About the artist</h4>
                                <span id="rightSidebarArtistName">Spotify Charts</span>
                            </div>
                        </div>
                        <p class="about-artist-bio" id="rightSidebarArtistBio">Your daily update of the most played tracks right now.</p>
                        <div class="about-artist-footer">
                            <span id="rightSidebarMonthlyListeners">626,892,110 monthly listeners</span>
                            <button class="badge dark-badge" id="rightSidebarFollowBtn">Follow</button>
                        </div>
                    </div>

                    <!-- Next in Queue Preview -->
                    <div class="right-sidebar-queue-box">
                        <div class="queue-box-header">
                            <span class="queue-title">Next in queue</span>
                            <button class="queue-open-link" id="rightSidebarOpenQueueBtn">Open queue</button>
                        </div>
                        <div class="queue-next-track" id="rightSidebarNextTrack">
                            <img src="/assesst/card2img.jpeg" id="rightSidebarNextImg" alt="Next" onerror="this.onerror=null;this.src='/assesst/card2img.jpeg';">
                            <div class="queue-next-meta">
                                <span class="queue-next-name" id="rightSidebarNextName">Daily Mix 1</span>
                                <span class="queue-next-artist" id="rightSidebarNextArtist">Spotify</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
