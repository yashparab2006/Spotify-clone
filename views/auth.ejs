<%- include('partials/head', { pageTitle: 'Spotify - Login or Sign Up' }) %>

<div class="main">
    <%- include('partials/sidebar', { activePage: 'auth', playlists: typeof playlists !== 'undefined' ? playlists : [] }) %>

    <!-- ========== MAIN CONTENT ========== -->
    <div class="main-content" id="mainContent">
        <%- include('partials/topbar', { activePage: 'auth', user: typeof user !== 'undefined' ? user : null }) %>

        <!-- ===== PAGE: AUTH (SIGN IN & REGISTER) ===== -->
        <div class="page" id="pageAuth" style="display:block; padding: 2rem 0;">
            <div class="auth-page-container" style="max-width: 480px; margin: 0 auto; padding: 0 1rem;">
                <div class="auth-card" style="background: #121212; border-radius: 12px; padding: 2.5rem 2rem; border: 1px solid #282828; box-shadow: 0 8px 32px rgba(0,0,0,0.6);">
                    <!-- Auth Header & Brand Logo -->
                    <div class="auth-header" style="text-align: center; margin-bottom: 2rem;">
                        <div class="auth-logo-badge" style="width: 54px; height: 54px; background: #000; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1rem; border: 1px solid #333;">
                            <i class="fa-brands fa-spotify" style="font-size: 2.2rem; color: #1ed760;"></i>
                        </div>
                        <h1 class="auth-title" id="authMainTitle" style="font-size: 1.8rem; font-weight: 800; margin-bottom: 0.5rem; color: #fff;">Life is happening now</h1>
                        <p class="auth-subtitle" style="color: #b3b3b3; font-size: 0.9rem; line-height: 1.4;">Log in or sign up to save playlists, follow artists, and stream high-fidelity sound.</p>
                    </div>

                    <!-- Tab Switcher: Log In vs Sign Up -->
                    <div class="auth-tabs" style="display: flex; gap: 0.5rem; background: #242424; padding: 4px; border-radius: 50px; margin-bottom: 1.8rem;">
                        <button class="auth-tab-btn <%= (typeof tab !== 'undefined' && tab === 'register') ? '' : 'active-auth-tab' %>" id="authTabLogin" type="button" style="flex:1; padding: 0.6rem; border-radius: 50px; font-weight: 700; border: none; cursor: pointer; transition: all 0.2s;">Log In</button>
                        <button class="auth-tab-btn <%= (typeof tab !== 'undefined' && tab === 'register') ? 'active-auth-tab' : '' %>" id="authTabRegister" type="button" style="flex:1; padding: 0.6rem; border-radius: 50px; font-weight: 700; border: none; cursor: pointer; transition: all 0.2s;">Sign Up</button>
                    </div>

                    <!-- Social Fast Auth Buttons -->
                    <div class="social-auth-buttons" style="display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.5rem;">
                        <button class="social-auth-btn" id="socialGoogleBtn" type="button" style="display: flex; align-items: center; justify-content: center; gap: 0.8rem; padding: 0.7rem; border-radius: 50px; background: transparent; border: 1px solid #727272; color: #fff; font-weight: 700; cursor: pointer;">
                            <i class="fa-brands fa-google"></i> Continue with Google
                        </button>
                        <button class="social-auth-btn" id="socialFacebookBtn" type="button" style="display: flex; align-items: center; justify-content: center; gap: 0.8rem; padding: 0.7rem; border-radius: 50px; background: transparent; border: 1px solid #727272; color: #fff; font-weight: 700; cursor: pointer;">
                            <i class="fa-brands fa-facebook"></i> Continue with Facebook
                        </button>
                        <button class="social-auth-btn" id="socialAppleBtn" type="button" style="display: flex; align-items: center; justify-content: center; gap: 0.8rem; padding: 0.7rem; border-radius: 50px; background: transparent; border: 1px solid #727272; color: #fff; font-weight: 700; cursor: pointer;">
                            <i class="fa-brands fa-apple"></i> Continue with Apple
                        </button>
                    </div>

                    <div class="auth-divider" style="display: flex; align-items: center; text-align: center; margin: 1.5rem 0; color: #727272; font-size: 0.8rem;">
                        <span style="flex: 1; border-bottom: 1px solid #282828;"></span>
                        <span style="padding: 0 0.8rem;">or with email</span>
                        <span style="flex: 1; border-bottom: 1px solid #282828;"></span>
                    </div>

                    <!-- Form 1: Log In -->
                    <form class="auth-form" id="loginForm" style="<%= (typeof tab !== 'undefined' && tab === 'register') ? 'display:none;' : 'display:flex;' %> flex-direction: column; gap: 1rem;">
                        <div class="auth-input-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
                            <label for="loginEmailInput" style="font-size: 0.85rem; font-weight: 700; color: #fff;">Email or username</label>
                            <div class="auth-input-wrapper" style="position: relative; display: flex; align-items: center;">
                                <i class="fa-regular fa-envelope input-icon" style="position: absolute; left: 1rem; color: #a7a7a7;"></i>
                                <input type="text" id="loginEmailInput" placeholder="Email or username" autocomplete="username" value="alex@spotify.com" style="width: 100%; padding: 0.75rem 1rem 0.75rem 2.5rem; background: #242424; border: 1px solid #3e3e3e; border-radius: 6px; color: #fff; font-size: 0.95rem;">
                            </div>
                        </div>

                        <div class="auth-input-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
                            <label for="loginPasswordInput" style="font-size: 0.85rem; font-weight: 700; color: #fff;">Password</label>
                            <div class="auth-input-wrapper" style="position: relative; display: flex; align-items: center;">
                                <i class="fa-solid fa-lock input-icon" style="position: absolute; left: 1rem; color: #a7a7a7;"></i>
                                <input type="password" id="loginPasswordInput" placeholder="Password" autocomplete="current-password" value="password123" style="width: 100%; padding: 0.75rem 2.5rem 0.75rem 2.5rem; background: #242424; border: 1px solid #3e3e3e; border-radius: 6px; color: #fff; font-size: 0.95rem;">
                                <button type="button" class="toggle-password-btn" id="toggleLoginPass" title="Toggle password visibility" style="position: absolute; right: 1rem; background: transparent; border: none; color: #a7a7a7; cursor: pointer;">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="auth-options-row" style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
                            <label class="remember-me-label" style="display: flex; align-items: center; gap: 0.5rem; color: #b3b3b3; cursor: pointer;">
                                <input type="checkbox" id="rememberMeCheckbox" checked>
                                <span>Remember me</span>
                            </label>
                            <a href="#" class="forgot-link" id="forgotPassLink" onclick="event.preventDefault();alert('Password reset link sent to registered email.');" style="color: #1ed760; text-decoration: none;">Forgot password?</a>
                        </div>

                        <button type="submit" class="badge auth-submit-btn" id="loginSubmitBtn" style="width: 100%; padding: 0.85rem; font-size: 1rem; font-weight: 800; border-radius: 50px; background: #1ed760; color: #000; border: none; cursor: pointer; margin-top: 0.5rem;">Log In</button>

                        <p class="auth-switch-text" style="text-align: center; color: #b3b3b3; font-size: 0.85rem; margin-top: 1rem;">
                            Don't have an account? <a href="#" id="switchToRegisterPrompt" style="color: #fff; font-weight: 700; text-decoration: underline;">Sign up for Spotify</a>.
                        </p>
                    </form>

                    <!-- Form 2: Sign Up / Register -->
                    <form class="auth-form" id="registerForm" style="<%= (typeof tab !== 'undefined' && tab === 'register') ? 'display:flex;' : 'display:none;' %> flex-direction: column; gap: 1rem;">
                        <div class="auth-input-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
                            <label for="regEmailInput" style="font-size: 0.85rem; font-weight: 700; color: #fff;">What's your email?</label>
                            <div class="auth-input-wrapper" style="position: relative; display: flex; align-items: center;">
                                <i class="fa-regular fa-envelope input-icon" style="position: absolute; left: 1rem; color: #a7a7a7;"></i>
                                <input type="email" id="regEmailInput" placeholder="name@domain.com" autocomplete="email" style="width: 100%; padding: 0.75rem 1rem 0.75rem 2.5rem; background: #242424; border: 1px solid #3e3e3e; border-radius: 6px; color: #fff; font-size: 0.95rem;">
                            </div>
                            <span class="auth-input-hint" style="color: #a7a7a7; font-size: 0.75rem;">You will need to confirm this email address.</span>
                        </div>

                        <div class="auth-input-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
                            <label for="regPasswordInput" style="font-size: 0.85rem; font-weight: 700; color: #fff;">Create a password</label>
                            <div class="auth-input-wrapper" style="position: relative; display: flex; align-items: center;">
                                <i class="fa-solid fa-lock input-icon" style="position: absolute; left: 1rem; color: #a7a7a7;"></i>
                                <input type="password" id="regPasswordInput" placeholder="Create a password" autocomplete="new-password" style="width: 100%; padding: 0.75rem 2.5rem 0.75rem 2.5rem; background: #242424; border: 1px solid #3e3e3e; border-radius: 6px; color: #fff; font-size: 0.95rem;">
                                <button type="button" class="toggle-password-btn" id="toggleRegPass" title="Toggle password visibility" style="position: absolute; right: 1rem; background: transparent; border: none; color: #a7a7a7; cursor: pointer;">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                            <span class="auth-input-hint" style="color: #a7a7a7; font-size: 0.75rem;">Use at least 6 characters.</span>
                        </div>

                        <div class="auth-input-group" style="display: flex; flex-direction: column; gap: 0.4rem;">
                            <label for="regNameInput" style="font-size: 0.85rem; font-weight: 700; color: #fff;">What should we call you?</label>
                            <div class="auth-input-wrapper" style="position: relative; display: flex; align-items: center;">
                                <i class="fa-regular fa-user input-icon" style="position: absolute; left: 1rem; color: #a7a7a7;"></i>
                                <input type="text" id="regNameInput" placeholder="Profile display name" autocomplete="name" style="width: 100%; padding: 0.75rem 1rem 0.75rem 2.5rem; background: #242424; border: 1px solid #3e3e3e; border-radius: 6px; color: #fff; font-size: 0.95rem;">
                            </div>
                            <span class="auth-input-hint" style="color: #a7a7a7; font-size: 0.75rem;">This appears on your profile and public playlists.</span>
                        </div>

                        <div class="auth-terms-box" style="margin: 0.5rem 0;">
                            <label class="remember-me-label" style="display: flex; align-items: center; gap: 0.5rem; color: #b3b3b3; font-size: 0.8rem; cursor: pointer;">
                                <input type="checkbox" id="termsCheck" checked>
                                <span>I agree to Spotify's Terms of Use and Privacy Policy.</span>
                            </label>
                        </div>

                        <button type="submit" class="badge auth-submit-btn" id="registerSubmitBtn" style="width: 100%; padding: 0.85rem; font-size: 1rem; font-weight: 800; border-radius: 50px; background: #1ed760; color: #000; border: none; cursor: pointer;">Sign Up</button>

                        <p class="auth-switch-text" style="text-align: center; color: #b3b3b3; font-size: 0.85rem; margin-top: 1rem;">
                            Already have an account? <a href="#" id="switchToLoginPrompt" style="color: #fff; font-weight: 700; text-decoration: underline;">Log in here</a>.
                        </p>
                    </form>
                </div>
            </div>
        </div>

        <%- include('partials/music-page') %>
    </div>

    <%- include('partials/right-rail') %>
    <%- include('partials/player') %>
</div>

<%- include('partials/modals') %>
<%- include('partials/scripts') %>

