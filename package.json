{
  "name": "spotify-clone",
  "version": "1.0.0",
  "description": "Full-Stack Spotify Clone with Node.js, Express, and Web Audio",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node test_express_in_process.js",
    "build": "node build_bundle.js",
    "build:ts": "node node_modules/typescript/bin/tsc",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "keywords": [
    "spotify",
    "express",
    "nodejs",
    "audio",
    "music-player"
  ],
  "author": "Spotify Clone Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^7.0.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
